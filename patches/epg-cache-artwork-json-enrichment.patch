diff --git a/api/rest/tests/test_epg_cache_controller.cpp b/api/rest/tests/test_epg_cache_controller.cpp
index 6f08e8d..ff85c13 100644
--- a/api/rest/tests/test_epg_cache_controller.cpp
+++ b/api/rest/tests/test_epg_cache_controller.cpp
@@ -1,4 +1,7 @@
 #include "Database.h"
+#include "EpgArtworkPublicJsonSerializer.h"
+#include "EpgArtworkReference.h"
+#include "EpgArtworkRepository.h"
 #include "EpgCacheController.h"
 #include "EpgCacheService.h"
 #include "IVdrAdapter.h"
@@ -317,6 +320,71 @@ static void test_window_read_filters_multiple_channel_ids()
     assert(adapter.boundedEventCalls == 1);
 }
 
+static void test_event_json_contains_public_artwork_contract()
+{
+    const char* databasePath =
+        "/tmp/vdr-suite-epg-cache-controller-artwork-test.db";
+    std::remove(databasePath);
+
+    Database database;
+    assert(database.open(databasePath));
+
+    EpgEventRepository eventRepository(database);
+    EpgArtworkRepository artworkRepository(database);
+    assert(artworkRepository.ensureSchema());
+
+    MockEventAdapter adapter;
+    VdrService vdrService(adapter);
+    EpgCacheService service(eventRepository, vdrService);
+    EpgArtworkPublicJsonSerializer artworkJsonSerializer;
+    EpgCacheController controller(
+        service,
+        artworkRepository,
+        artworkJsonSerializer);
+
+    VdrEventQuery query;
+    query.limit = 2;
+
+    adapter.events = {
+        make_event("event-1", "channel one/HD", "With Artwork", "0900", "1000"),
+        make_event("event-2", "channel-2", "Without Artwork", "1000", "1100")};
+
+    const ApiResponse refresh =
+        controller.refreshBackendWindow("home vdr", query);
+    assert(refresh.statusCode == 200);
+
+    EpgArtworkReference artwork;
+    artwork.backendId = "home vdr";
+    artwork.channelId = "channel one/HD";
+    artwork.eventId = "event-1";
+    artwork.provider = "tvscraper";
+    artwork.path = "/var/cache/vdr/tvscraper/private-event-1.jpg";
+    artwork.width = 1280;
+    artwork.height = 720;
+    artwork.resolvedAt = 123456;
+    assert(artworkRepository.upsert(artwork));
+
+    const ApiResponse window = controller.getWindow(
+        "home vdr",
+        "channel one/HD,channel-2",
+        "0900",
+        "1200",
+        0);
+
+    assert(window.statusCode == 200);
+    assert(contains(window.body, "\"artwork\":{\"available\":true"));
+    assert(contains(window.body, "\"provider\":\"tvscraper\""));
+    assert(contains(window.body, "\"width\":1280"));
+    assert(contains(window.body, "\"height\":720"));
+    assert(contains(window.body, "backend=home%20vdr"));
+    assert(contains(window.body, "channelId=channel%20one%2FHD"));
+    assert(contains(window.body, "eventId=event-1"));
+    assert(contains(window.body, "\"artwork\":{\"available\":false}"));
+    assert(!contains(window.body, artwork.path));
+    assert(!contains(window.body, "/var/cache"));
+}
+
 
 int main()
 {
@@ -324,6 +392,7 @@ int main()
     test_status_reports_count_and_last_refresh_metadata();
     test_window_read_defaults_empty_backend_to_default();
     test_window_read_filters_multiple_channel_ids();
+    test_event_json_contains_public_artwork_contract();
 
     return 0;
 }
