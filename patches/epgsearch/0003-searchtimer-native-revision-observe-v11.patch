+static bool ValidNativeRevision(const std::string& value)
+{
+    if (value.size() != 35 || value.compare(0, 3, "sr_") != 0)
+        return false;
+    for (size_t i = 3; i < value.size(); ++i)
+        if ((value[i] < '0' || value[i] > '9') &&
+            (value[i] < 'a' || value[i] > 'f'))
+            return false;
+    return true;
+}
