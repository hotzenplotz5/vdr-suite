+// An opt-in metadata comment; the legacy 59-field rule stays unchanged.
+static const char nativeGenerationMarker[] = "#vdr-suite-generation:";
+
+static bool ValidNativeGeneration(const std::string& value)
+{
+    if (value.size() != 35 || value.compare(0, 3, "sg_") != 0)
+        return false;
+    for (size_t i = 3; i < value.size(); ++i)
+        if ((value[i] < '0' || value[i] > '9') &&
+            (value[i] < 'a' || value[i] > 'f'))
+            return false;
+    return true;
+}
+
+static bool RandomNativeGeneration(std::string& out)
+{
+    unsigned char bytes[16];
+    FILE *entropy = fopen("/dev/urandom", "rb");
+    if (!entropy)
+        return false;
+    bool ok = fread(bytes, 1, sizeof(bytes), entropy) == sizeof(bytes);
+    if (fclose(entropy) != 0)
+        ok = false;
+    if (!ok)
+        return false;
+    static const char alphabet[] = "0123456789abcdef";
+    out = "sg_";
+    for (size_t i = 0; i < sizeof(bytes); ++i) {
+        out += alphabet[bytes[i] >> 4];
+        out += alphabet[bytes[i] & 15];
+    }
+    return true;
+}
