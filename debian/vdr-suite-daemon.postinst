#!/bin/sh
set -e

# Only a genuinely new installation starts the Suite daemon automatically.
# Upgrades must retain the host's existing service policy.
if [ "$1" = configure ] && [ -z "${2:-}" ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper enable vdr-suite-daemon.service >/dev/null || true
    fi
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke start vdr-suite-daemon.service >/dev/null || true
    fi
fi

#DEBHELPER#
exit 0
