#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Explicitly supported profile: dpkg-buildpackage -B -Pplugin-only
# No daemon, agent, CLI or web assets are built or staged in that profile.
PLUGIN_ONLY := $(filter plugin-only,$(DEB_BUILD_PROFILES))
STAGE := $(CURDIR)/debian/tmp

%:
	dh $@ --with vdrplugin

override_dh_auto_build:
ifeq ($(PLUGIN_ONLY),)
	$(MAKE) build-installable PREFIX=/usr
endif
	$(MAKE) -C vdr-plugin-suite-bridge

override_dh_auto_install:
ifeq ($(PLUGIN_ONLY),)
	$(MAKE) install DESTDIR=$(STAGE) PREFIX=/usr SYSTEMDUNITDIR=/usr/lib/systemd/system
endif
	$(MAKE) -C vdr-plugin-suite-bridge install DESTDIR=$(STAGE)
	# SuiteBridge owns private /run transport roots even in plugin-only packages.
	install -D -m 0644 packaging/systemd/vdr-suite-live.conf $(STAGE)/usr/lib/tmpfiles.d/vdr-suite-live.conf
	# Fail closed if runtime-generated private data was staged.
	test ! -e $(STAGE)/var/lib/vdr-suite/vdr-suite.db
	test ! -e $(STAGE)/var/lib/vdr-suite/secrets/credentials

override_dh_auto_test:
	python3 tools/check_packaging_version.py
	python3 -m unittest discover -s tools -p 'test_packaging_*.py'

# dh_installdeb assembles package control directories before dh_builddeb.
# Generate package-specific, manifest-derived preinst collision guards there.
override_dh_installdeb:
	dh_installdeb
	python3 tools/packaging_p8_preinst.py --stage

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_missing:
	dh_missing --fail-missing
