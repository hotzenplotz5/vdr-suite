# Runtime overrides for vdr-suite-daemon.
#
# Suite Bridge is an optional, read-only local VDR integration and remains
# disabled until explicitly enabled by the operator.

VDR_SUITE_SUITE_BRIDGE_ENABLED=false
VDR_SUITE_SUITE_BRIDGE_BACKEND_ID=default
VDR_SUITE_SUITE_BRIDGE_HOST=127.0.0.1
VDR_SUITE_SUITE_BRIDGE_PORT=6419

# Bounded transport and observation timings in milliseconds.
VDR_SUITE_SUITE_BRIDGE_CONNECT_TIMEOUT_MS=1000
VDR_SUITE_SUITE_BRIDGE_IO_TIMEOUT_MS=1000
VDR_SUITE_SUITE_BRIDGE_OPERATION_TIMEOUT_MS=3000
VDR_SUITE_SUITE_BRIDGE_POLL_INTERVAL_MS=5000
VDR_SUITE_SUITE_BRIDGE_STALE_AFTER_MS=15000
VDR_SUITE_SUITE_BRIDGE_OFFLINE_AFTER_MS=60000
VDR_SUITE_SUITE_BRIDGE_RECONNECT_INITIAL_MS=1000
VDR_SUITE_SUITE_BRIDGE_RECONNECT_MAXIMUM_MS=30000

# Optional external series-artwork fallback. Both the global switch and the
# explicit provider selection are required. The default remains fully offline.
VDR_SUITE_SERIES_ARTWORK_FALLBACK_ENABLED=false
VDR_SUITE_SERIES_ARTWORK_FALLBACK_PROVIDER=none
VDR_SUITE_SERIES_ARTWORK_FALLBACK_SOURCE_ROOTS=/var/cache/vdr-suite/epg-artwork/incoming
VDR_SUITE_SERIES_ARTWORK_FALLBACK_CACHE_ROOT=/var/cache/vdr-suite/epg-artwork/external
VDR_SUITE_SERIES_ARTWORK_FALLBACK_MAX_BYTES=16777216
VDR_SUITE_SERIES_ARTWORK_FALLBACK_MAX_DIMENSION=16384

# Optional one-pass startup cleanup for old, unreferenced managed fallback
# files. It is independently opt-in and examines only the materializer-owned
# hex directory layout and exact series.png/series.jpg filenames. The default
# keeps all files and performs no deletion.
VDR_SUITE_SERIES_ARTWORK_FALLBACK_ORPHAN_CLEANUP_ENABLED=false
VDR_SUITE_SERIES_ARTWORK_FALLBACK_ORPHAN_CLEANUP_MIN_AGE_SECONDS=604800
VDR_SUITE_SERIES_ARTWORK_FALLBACK_ORPHAN_CLEANUP_MAX_FILES=64

# Optional one-pass startup cleanup for stale files in the TMDB incoming root.
# Only the provider-owned tmdb-<id>-<hash>.candidate namespace and its exact
# atomic .tmp form are eligible. Foreign entries remain untouched. The default
# performs no deletion.
VDR_SUITE_SERIES_ARTWORK_FALLBACK_INCOMING_CLEANUP_ENABLED=false
VDR_SUITE_SERIES_ARTWORK_FALLBACK_INCOMING_CLEANUP_MIN_AGE_SECONDS=86400
VDR_SUITE_SERIES_ARTWORK_FALLBACK_INCOMING_CLEANUP_MAX_FILES=64

# TMDB is selected only with provider=tmdb and a valid API Read Access Token.
# Store the token in an operator-owned mode-0600 systemd environment file or
# drop-in; do not commit it and do not place it in this packaged example.
# VDR_SUITE_TMDB_READ_ACCESS_TOKEN=
VDR_SUITE_TMDB_LANGUAGE=de-DE
VDR_SUITE_TMDB_INCLUDE_IMAGE_LANGUAGES=de,en,null
VDR_SUITE_TMDB_CONNECT_TIMEOUT_MS=2000
VDR_SUITE_TMDB_TOTAL_TIMEOUT_MS=8000
VDR_SUITE_TMDB_MAX_RETRIES=1
VDR_SUITE_TMDB_RETRY_BACKOFF_MS=250
VDR_SUITE_TMDB_NEGATIVE_CACHE_TTL_SECONDS=21600
VDR_SUITE_TMDB_TRANSIENT_CACHE_TTL_SECONDS=300
VDR_SUITE_TMDB_MAX_JSON_BYTES=524288

# Absolute browser-session lifetime in seconds. Values must be strict decimal
# integers from 300 through 86400. This is not an idle timeout or refresh
# interval. The same value controls the persisted expiry and cookie Max-Age.
VDR_SUITE_BROWSER_SESSION_LIFETIME_SECONDS=28800

# Maximum effective active browser sessions per actor. Values must be strict
# decimal integers from 0 through 64. Zero preserves unlimited compatibility
# behaviour. Reaching a non-zero limit rejects a new session and never evicts an
# existing one.
VDR_SUITE_BROWSER_SESSION_MAX_ACTIVE_PER_ACTOR=0

# Optional server-side browser-session idle timeout in seconds. Zero preserves
# compatibility by disabling idle expiry. Enabled values must be strict decimal
# integers from 300 through 86400. Activity updates are server-owned and
# throttled; they never extend the absolute browser-session lifetime.
VDR_SUITE_BROWSER_SESSION_IDLE_TIMEOUT_SECONDS=0

# Optional terminal browser-session retention delay in seconds. Zero preserves
# compatibility by disabling physical cleanup. Enabled values must be strict
# decimal integers from 86400 through 31536000. Startup performs one deterministic
# fixed startup batch of at most 256 terminal browser-session lifecycles.
VDR_SUITE_BROWSER_SESSION_RETENTION_SECONDS=0
