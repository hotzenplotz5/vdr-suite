# Runtime overrides for vdr-suite-daemon.
#
# Suite Bridge is an optional, read-only local VDR integration and remains
# disabled until explicitly enabled by the operator.

VDR_SUITE_SUITE_BRIDGE_ENABLED=false
VDR_SUITE_SUITE_BRIDGE_BACKEND_ID=default
VDR_SUITE_SUITE_BRIDGE_HOST=127.0.0.1
VDR_SUITE_SUITE_BRIDGE_PORT=6419

# Bounded transport and observation timings in milliseconds.
VDR_SUITE_SUITE_BRIDGE_CONNECT_TIMEOUT_MS=1000
VDR_SUITE_SUITE_BRIDGE_IO_TIMEOUT_MS=1000
VDR_SUITE_SUITE_BRIDGE_OPERATION_TIMEOUT_MS=3000
VDR_SUITE_SUITE_BRIDGE_POLL_INTERVAL_MS=5000
VDR_SUITE_SUITE_BRIDGE_STALE_AFTER_MS=15000
VDR_SUITE_SUITE_BRIDGE_OFFLINE_AFTER_MS=60000
VDR_SUITE_SUITE_BRIDGE_RECONNECT_INITIAL_MS=1000
VDR_SUITE_SUITE_BRIDGE_RECONNECT_MAXIMUM_MS=30000

# Absolute browser-session lifetime in seconds. Values must be strict decimal
# integers from 300 through 86400. This is not an idle timeout or refresh
# interval. The same value controls the persisted expiry and cookie Max-Age.
VDR_SUITE_BROWSER_SESSION_LIFETIME_SECONDS=28800