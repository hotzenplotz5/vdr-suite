          }
        }
      },
      "ChannelCollectionSource": {
        "type": "object",
        "required": [
          "backendId",
          "state"
        ],
        "properties": {
          "backendId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "code": {
            "type": "string",
            "description": "Present for unavailable sources; backend_unavailable is used by current source."
          }
        }
      }
    }
  }
}
