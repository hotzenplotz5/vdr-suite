      "PublicProblemDetails": {
        "type": "object",
        "description": "Problem Details-compatible error payload serialized by core/http/include/PublicProblemDetails.h and the public REST runtime. Some security-gate rejections occur before the REST handler.",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "urn:vdr-suite:error:<code with underscores replaced by hyphens>"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "BackendCollection": {
        "type": "object",
        "description": "Suite-owned actor-scoped Backend collection. No legacy frontend selector/write flags, backend connection/transport/provider details, or credentials.",
        "required": [
          "items",
          "page",
          "meta",
          "links"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackendIdentity"
            }
          },
          "page": {
            "$ref": "#/components/schemas/BackendPage"
          },
          "meta": {
            "$ref": "#/components/schemas/BackendCollectionMeta"
          },
          "links": {
            "$ref": "#/components/schemas/BackendCollectionLinks"
          }
        }
      },
      "BackendIdentity": {
        "type": "object",
        "required": [
          "backendId",
          "name",
          "enabled",
          "online"
        ],
        "properties": {
          "backendId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "online": {
            "type": "boolean"
          }
        }
      },
      "BackendPage": {
        "type": "object",
        "required": [
          "limit",
          "nextCursor",
          "hasMore"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque cursor, or null if there is no next page."
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "BackendCollectionMeta": {
        "type": "object",
        "required": [
          "partial"
        ],
        "properties": {
          "partial": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "BackendCollectionLinks": {
        "type": "object",
        "required": [
          "self",
          "next"
        ],
        "properties": {
          "self": {
            "type": "string",
            "description": "Server-generated canonical collection URL with normalized parameters."
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "Next-page URL or null."
          }
        }
      },
      "ChannelCollection": {
        "type": "object",
        "required": [
          "items",
          "page",
          "meta",
          "links"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelIdentity"
            }
          },
          "page": {
            "$ref": "#/components/schemas/BackendPage"
          },
          "meta": {
            "$ref": "#/components/schemas/ChannelCollectionMeta"
          },
          "links": {
            "$ref": "#/components/schemas/BackendCollectionLinks"
          }
        }
      },
      "ChannelIdentity": {
        "type": "object",
        "required": [
          "backendId",
          "channelId",
          "channelNumber",
          "name",
          "provider",
          "groupName",
          "radio",
          "encrypted",
          "enabled"
        ],
        "properties": {
          "backendId": {
            "type": "string"
          },
          "channelId": {
            "type": "string",
            "description": "Opaque VDR-Suite channel identity within one backend; pair (backendId, channelId) is the public identity."
          },
          "channelNumber": {
            "type": "integer",
            "description": "Attribute, not identity."
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "radio": {
            "type": "boolean"
          },
          "encrypted": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ChannelCollectionMeta": {
