          "responseEvolution",
          "breakingChanges",
          "unknownRequestFields",
          "legacyUnversioned",
          "lifecycle",
          "deprecationHeaders",
          "deprecatedAliases"
        ],
        "properties": {
          "policyVersion": {
            "type": "integer",
            "const": 1
          },
          "supportedApiMajors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responseEvolution": {
            "type": "string",
            "const": "additive"
          },
          "breakingChanges": {
            "type": "string",
            "const": "new-major"
