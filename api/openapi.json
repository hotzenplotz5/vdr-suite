{
  "openapi": "3.1.0",
  "info": {
    "title": "VDR-Suite Public API v1 — verified discovery, Backend and Channel collection subset",
    "version": "1.0.0",
    "description": "PARTIAL public-v1 developer contract for the two discovery GETs, actor-scoped Backend discovery and federated GET Channel collection, checked against source main 8d8dcfbf26d0b6760ad81dc4b2af4fbbd15d55b0 (2026-10-11). Not exhaustive and not a runtime installation/TV acceptance certificate. See api/README.md and ADR-0048."
  },
  "x-vdr-suite-coverage": "partial",
  "tags": [
    {
      "name": "Discovery",
      "description": "Public-v1 contract discovery and per-runtime capabilities"
    },
    {
      "name": "Backends",
      "description": "Authenticated, actor-scoped Suite Backend identity discovery"
    },
    {
      "name": "Channels",
      "description": "Authorized public-v1 federated Channel collection with explicit backend source selection and partial-source metadata"
    }
  ],
  "paths": {
    "/api/v1": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "operationId": "getPublicApiRoot",
        "summary": "Read the Public API v1 contract root",
        "description": "Source: api/rest/src/PublicApiRuntime.cpp, contractRoot(). Discovery may represent an anonymous caller; application-level authorization requirements of other resources are separate.",
        "security": [],
        "responses": {
          "200": {
            "description": "Compatibility/version metadata and discovery links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractRoot"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "operationId": "getPublicApiCapabilities",
        "summary": "Read runtime capabilities",
        "description": "Source: api/rest/src/PublicApiRuntime.cpp, platformCapabilities(). Each availability value depends on configured runtime services. Available here does not mean an individual actor has permission or that the installed TV integration has passed acceptance.",
        "security": [],
        "responses": {
          "200": {
            "description": "Runtime capability and compatibility description",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityDiscovery"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/backends": {
      "get": {
        "tags": [
          "Backends"
        ],
        "operationId": "listPublicBackends",
        "summary": "List backend identities visible to the authenticated actor",
        "description": "Source: api/rest/src/PublicApiRuntime.cpp, parsePublicBackendCollectionQuery()/publicBackendCollectionResponse(), and core/security/include/SecurityHttpGate.h. An authenticated actor is mandatory; visibility is derived from positive permission-grant backend scopes, not a new backends.view permission. role.read-only alone does not contribute scope. Authenticated users with no positive backend scopes receive an empty 200 collection. The exact authentication transport is deployment-dependent and is not expressed here as a single invented HTTP security scheme (see x-vdr-suite-authentication). A query cursor is opaque (currently be1_-prefixed) and bound to the normalized authorization scope. Restart pagination on 409 cursor_expired; never synthesize or parse cursors. Success responses include Cache-Control: no-store and do not include ETag. Other HTTP methods, including HEAD/OPTIONS, return 405 method_not_allowed with Allow: GET.",
        "x-vdr-suite-authentication": {
          "actorRequired": true,
          "authorization": "Positive permission grants determine visible backend scopes; no backends.view permission exists.",
          "securitySchemeDocumentation": "See ADR-0048, security gate and deployment identity configuration; credential transport is not fully modeled in this partial OpenAPI."
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, default 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque keyset cursor returned by page.nextCursor; no more than 4096 characters; tied to the actor's effective permission scopes.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Only backendId is accepted.",
            "schema": {
              "type": "string",
              "const": "backendId",
              "default": "backendId"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Only ascending order is accepted.",
            "schema": {
              "type": "string",
              "const": "asc",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actor-filtered Backends ordered by backendId ascending. No backend I/O; meta.partial is always false.",
            "headers": {
              "Cache-Control": {
                "description": "No client or proxy caching for this response.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendCollection"
                },
                "examples": {
                  "singlePage": {
                    "summary": "Example with one visible backend",
                    "value": {
                      "items": [
                        {
                          "backendId": "backend-a",
                          "name": "Living Room",
                          "enabled": true,
                          "online": true
                        }
                      ],
                      "page": {
                        "limit": 50,
                        "nextCursor": null,
                        "hasMore": false
                      },
                      "meta": {
                        "partial": false
                      },
                      "links": {
                        "self": "/api/v1/backends?limit=50&sort=backendId&order=asc",
                        "next": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid/duplicate query parameter, malformed cursor or invalid Backend discovery scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No authenticated actor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The authorization scope no longer matches the cursor; code cursor_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Permission resolution, collection runtime or its validated output is unavailable; code may depend on rejection layer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/channels": {
      "get": {
        "tags": [
          "Channels"
        ],
        "operationId": "listPublicChannels",
        "summary": "List Channels from explicitly selected and authorized VDR backends",
        "description": "An authenticated actor must provide 1–16 distinct backendId query members. Each requested source is independently authorized with channels.view@backend; one denial rejects the entire request, before collection evaluation. The order is (backendId ASC, channelId ASC). The opaque ch1_-prefixed cursor binds the normalized backend source set and last item; source-set mismatch returns 409 cursor_expired. A 200 response may be partial: meta.sources gives all requested sources, and unavailable sources are not silently hidden. At least one source must succeed for a 200; all unavailable yields 503 backend_unavailable. The response has Cache-Control: no-store and no collection ETag. No legacy /api/vdr/channels fallback is permitted by this contract.",
        "x-vdr-suite-authentication": {
          "actorRequired": true,
          "authorization": "channels.view for every explicitly requested backendId",
          "securitySchemeDocumentation": "Deployment authentication transports are not yet fully modeled in this partial OpenAPI; review the SecurityHttpGate and identity contracts."
        },
        "parameters": [
          {
            "name": "backendId",
            "in": "query",
            "required": true,
            "description": "Required repeated query key, 1–16 DISTINCT source IDs, e.g. ?backendId=backend-a&backendId=backend-b; omission does not select a default. Each ID 1–128 chars, alphanumeric, dot, underscore or hyphen.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of Channels returned per page; default 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor returned by page.nextCursor, source-set bound and nonportable across changed source scopes. Do not decode.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Exact required order of keyset fields.",
            "schema": {
              "type": "string",
              "const": "backendId,channelId",
              "default": "backendId,channelId"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Only ascending order is supported.",
            "schema": {
              "type": "string",
              "const": "asc",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One or more sources succeeded. meta.partial may be true, with explicit per-source status and code.",
            "headers": {
              "Cache-Control": {
                "description": "No caching.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelCollection"
                },
                "examples": {
                  "partial": {
                    "summary": "One backend succeeded; another was unavailable",
                    "value": {
                      "items": [
                        {
                          "backendId": "backend-a",
                          "channelId": "S19.2E-1-1019-10301",
                          "channelNumber": 1,
                          "name": "Channel One",
                          "provider": "provider",
                          "groupName": "group",
                          "radio": false,
                          "encrypted": false,
                          "enabled": true
                        }
                      ],
                      "page": {
                        "limit": 50,
                        "nextCursor": null,
                        "hasMore": false
                      },
                      "meta": {
                        "partial": true,
                        "sources": [
                          {
                            "backendId": "backend-a",
                            "state": "ok"
                          },
                          {
                            "backendId": "backend-b",
                            "state": "unavailable",
                            "code": "backend_unavailable"
                          }
                        ]
                      },
                      "links": {
                        "self": "/api/v1/channels?backendId=backend-a&backendId=backend-b&limit=50&sort=backendId,channelId&order=asc",
                        "next": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing, duplicated or invalid backend scope; invalid/unsupported query or malformed cursor. REST handler code invalid_request; security gate may return invalid_backend_scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "One or more requested backends lack channels.view permission; no source results are disclosed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported HTTP method; Allow: GET.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            },
            "headers": {
              "Allow": {
                "description": "Only GET is supported.",
                "schema": {
                  "type": "string",
                  "const": "GET"
                }
              }
            }
          },
          "409": {
            "description": "Cursor backend source scope differs from selected source set; code cursor_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "All requested sources unavailable (backend_unavailable), or a required runtime/service/accountability layer is unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContractRoot": {
        "type": "object",
        "required": [
          "apiVersion",
          "serverVersion",
          "supportedApiMajors",
          "compatibilityPolicy",
          "authentication",
          "links"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "v1"
          },
          "serverVersion": {
            "type": "string",
            "description": "Running daemon's build identity, not the API major."
          },
          "supportedApiMajors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compatibilityPolicy": {
            "$ref": "#/components/schemas/CompatibilityPolicy"
          },
          "authentication": {
            "type": "object",
            "required": [
              "authenticated"
            ],
            "properties": {
              "authenticated": {
                "type": "boolean"
              }
            }
          },
          "links": {
            "type": "object",
            "required": [
              "self",
              "capabilities",
              "backends",
              "accounts",
              "devicePairings"
            ],
            "properties": {
              "self": {
                "type": "string"
              },
              "capabilities": {
                "type": "string"
              },
              "backends": {
                "type": "string"
              },
              "accounts": {
                "type": "string"
              },
              "devicePairings": {
                "type": "string"
              }
            }
          }
        }
      },
      "CompatibilityPolicy": {
        "type": "object",
        "required": [
          "version",
          "responseEvolution",
          "breakingChanges",
          "unknownRequestFields",
          "legacyUnversioned"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "responseEvolution": {
            "type": "string",
            "const": "additive"
          },
          "breakingChanges": {
            "type": "string",
            "const": "new-major"
          },
          "unknownRequestFields": {
